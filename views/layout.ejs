<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | SV Hambuch</title>
  <link rel="icon" type="image/svg+xml" href="/images/Logo%20Hambuch.svg">
  <link rel="preconnect" href="https://fonts.bunny.net">
  <link href="https://fonts.bunny.net/css?family=montserrat:400,500,600|merriweather:400,700" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="page-<%= currentPage %>">
  <a class="skip-link" href="#main">Zum Inhalt springen</a>
  <header class="site-header">
    <div class="container">
      <a href="/" class="logo" aria-label="Zur Startseite SV Hambuch">
        <img src="/images/Logo%20Hambuch.svg" alt="Logo SV Hambuch">
        <span>SV Hambuch</span>
      </a>
      <button class="nav-toggle" aria-label="Navigation umschalten" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav class="main-nav" aria-label="Hauptnavigation">
        <ul>
          <% navItems.forEach((item) => { %>
            <li class="<%= currentPage === item.key ? 'active' : '' %>">
              <a href="<%= item.url %>"><%= item.label %></a>
            </li>
          <% }) %>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <%- include(template) %>
  </main>

  <footer class="site-footer">
    <div class="container">
      <div>
        <h3>Vereinskontakt</h3>
        <address class="footer-address">
          <% site.postalAddress.forEach((line) => { %>
            <span><%= line %></span>
          <% }) %>
        </address>
        <p>1. Vorsitzender: <%= site.chair %></p>
        <p>Telefon: <a href="tel:<%= site.phoneHref %>"><%= site.phone %></a></p>
        <p class="footer-note">Jubiläumsjahr <%= site.jubileeYear %> · <%= site.anniversary %> Jahre SV Hambuch</p>
      </div>
      <div class="footer-links">
        <% navItems.forEach((item) => { %>
          <a href="<%= item.url %>"><%= item.label %></a>
        <% }) %>
      </div>
      <div class="footer-legal-links">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </div>
      <p class="copyright">&copy; <span id="year"></span> <%= site.name %> Alle Rechte vorbehalten.</p>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
