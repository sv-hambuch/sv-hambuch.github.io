<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Melde dich</p>
    <h1>Kontakt zum SV Hambuch</h1>
    <p class="lead">Du hast Fragen zu Trainings, Mitgliedschaft oder unseren Veranstaltungen? Wir helfen gerne weiter.</p>
  </div>
</section>

<section class="section">
  <div class="container contact-grid">
    <div class="contact-info">
      <h2>Verein</h2>
      <address>
        <% contact.address.forEach((line) => { %>
          <span><%= line %></span>
        <% }) %>
      </address>
      <p><strong>Telefon:</strong> <a href="tel:+492653123456"><%= contact.phone %></a></p>
      <p><strong>E-Mail:</strong> <a href="mailto:<%= contact.email %>"><%= contact.email %></a></p>

      <h3>Sprechzeiten Geschäftsstelle</h3>
      <ul class="bullet-list">
        <% contact.officeHours.forEach((slot) => { %>
          <li><strong><%= slot.day %>:</strong> <%= slot.time %></li>
        <% }) %>
      </ul>

      <h3>Vorstand</h3>
      <ul class="contact-board">
        <% contact.board.forEach((member) => { %>
          <li>
            <strong><%= member.role %></strong><br>
            <span><%= member.name %></span><br>
            <a href="mailto:<%= member.email %>"><%= member.email %></a>
          </li>
        <% }) %>
      </ul>
    </div>

    <form id="formular" class="contact-form" method="post" action="https://formspree.io/f/xaygvapo">
      <h2>Nachricht senden</h2>
      <p>Deine Anfrage landet direkt beim Vorstandsteam.</p>
      <label for="name">Name</label>
      <input id="name" name="name" type="text" placeholder="Dein Name" required>

      <label for="email">E-Mail</label>
      <input id="email" name="_replyto" type="email" placeholder="deine@mail.de" required>

      <label for="topic">Thema</label>
      <select id="topic" name="topic" required>
        <option value="">Bitte auswählen</option>
        <option value="mitgliedschaft">Mitgliedschaft</option>
        <option value="training">Training & Teams</option>
        <option value="veranstaltung">Veranstaltungen</option>
        <option value="sonstiges">Sonstiges</option>
      </select>

      <label for="message">Nachricht</label>
      <textarea id="message" name="message" rows="5" placeholder="Wie können wir helfen?" required></textarea>

      <button class="btn primary" type="submit">Nachricht senden</button>
      <p class="privacy-hint">Mit dem Absenden erklärst du dich mit der Speicherung deiner Angaben zur Kontaktaufnahme einverstanden.</p>
    </form>
  </div>
</section>
