<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Melde dich</p>
    <h1>Kontakt zum SV Hambuch</h1>
    <p class="lead">Fragen zu Mitgliedschaft, Angeboten und Veranstaltungen lassen sich am schnellsten direkt mit dem Verein klären.</p>
  </div>
</section>

<section class="section">
  <div class="container contact-grid">
    <div class="contact-info">
      <h2>Vereinskontakt</h2>
      <address>
        <% contact.postalAddress.forEach((line) => { %>
          <span><%= line %></span>
        <% }) %>
      </address>
      <p><strong><%= contact.contactPerson.role %>:</strong> <%= contact.contactPerson.name %></p>
      <p><strong>Telefon:</strong> <a href="tel:<%= contact.phoneHref %>"><%= contact.phone %></a></p>
      <p><%= contact.note %></p>
    </div>
  </div>
</section>
