<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Über uns</p>
    <p class="hero-badge">1976–2026 · 50 Jahre SV Hambuch</p>
    <h1>Der Verein hinter Sportplatz, Dorfmeisterschaft und Jubiläum</h1>
    <p class="lead"><%= club.mission %></p>
  </div>
</section>

<section class="section">
  <div class="container stats-grid">
    <% club.stats.forEach((item) => { %>
      <article>
        <span class="stat-number"><%= item.value %></span>
        <p><%= item.label %></p>
      </article>
    <% }) %>
  </div>
</section>

<section class="section">
  <div class="container story-columns">
    <% club.intro.forEach((paragraph) => { %>
      <article class="card">
        <p><%= paragraph %></p>
      </article>
    <% }) %>
  </div>
</section>

<section class="section highlight">
  <div class="container">
    <header class="section-header">
      <h2>Zeitleiste</h2>
      <p>Wichtige Stationen aus fünf Jahrzehnten SV Hambuch.</p>
    </header>
    <div class="timeline">
      <% club.timeline.forEach((item) => { %>
        <article class="card">
          <p class="timeline-year"><%= item.year %></p>
          <h3><%= item.title %></h3>
          <p><%= item.text %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container split section-top">
    <div>
      <h2>Unsere Werte</h2>
      <p>Was den SV Hambuch im Ort und im sportlichen Alltag auszeichnet.</p>
    </div>
    <ul class="values-list">
      <% club.values.forEach((value) => { %>
        <li><span><%= value %></span></li>
      <% }) %>
    </ul>
  </div>
</section>

<section class="section">
  <div class="container grid three">
    <% club.highlights.forEach((item) => { %>
      <article class="card">
        <p><%= item %></p>
      </article>
    <% }) %>
  </div>
</section>
