<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Mannschaften & Angebote</p>
    <h1>Fußball beim SV Hambuch ist Teamarbeit im besten Sinn</h1>
    <p class="lead">Vom Seniorenbereich in der regionalen Spielgemeinschaft bis zu inklusiven und dörflichen Formaten bleibt der Verein breit aufgestellt.</p>
  </div>
</section>

<section class="section">
  <div class="container grid two">
    <% teams.forEach((team) => { %>
      <article class="card team-card">
        <h2><%= team.name %></h2>
        <p class="meta"><%= team.label %></p>
        <p><%= team.description %></p>
        <ul class="bullet-list">
          <% team.items.forEach((item) => { %>
            <li><%= item %></li>
          <% }) %>
        </ul>
      </article>
    <% }) %>
  </div>
</section>
