<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Sportstätten & Termine</p>
    <h1>Die wichtigsten Vereinsorte des SV Hambuch</h1>
    <p class="lead">Statt unzuverlässiger Platzhalterzeiten zeigt diese Seite die realen Orte und wiederkehrenden Formate, die öffentlich für den Verein belegt sind.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <header class="section-header">
      <h2>Vereinsorte</h2>
      <p>Diese Anlagen und Treffpunkte bilden die Grundlage für Spielbetrieb, Training und Vereinsorganisation.</p>
    </header>
    <div class="grid two">
      <% schedule.venues.forEach((venue) => { %>
        <article class="card venue-card">
          <h3><%= venue.name %></h3>
          <p class="meta"><%= venue.address %></p>
          <p><%= venue.description %></p>
          <ul class="bullet-list">
            <% venue.details.forEach((detail) => { %>
              <li><%= detail %></li>
            <% }) %>
          </ul>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section highlight">
  <div class="container">
    <header class="section-header">
      <h2>Wiederkehrende Formate</h2>
      <p>Diese Termine und Veranstaltungsformen tauchen öffentlich rund um den SV Hambuch auf.</p>
    </header>
    <div class="grid two">
      <% schedule.recurringEvents.forEach((entry) => { %>
        <article class="card">
          <h3><%= entry.title %></h3>
          <p class="meta"><%= entry.meta %></p>
          <p><%= entry.text %></p>
        </article>
      <% }) %>
    </div>
    <p class="section-note"><%= schedule.notice %></p>
  </div>
</section>
